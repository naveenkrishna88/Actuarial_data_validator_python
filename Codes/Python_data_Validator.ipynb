    "                    \"Severity\": severity,\n",
    "                    \"Description\": desc\n",
    "                }\n",
    "                validation_report_list.append(err_dict)\n",
    "\n",
    "### Fallback if no violations are found\n",
    "if len(validation_report_list) == 0:\n",
    "    validation_report = pd.DataFrame([{\"Message\": \"No validation errors found.\"}])\n",
